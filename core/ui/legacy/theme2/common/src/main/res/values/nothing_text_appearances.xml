<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing OS inspired text appearances: Doto for display/headline, Inter for body. -->
<resources>
    <style name="TextAppearance.Nothing.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="fontFamily">@font/doto</item>
        <item name="android:fontFamily">@font/doto</item>
    </style>
    <style name="TextAppearance.Nothing.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="fontFamily">@font/doto</item>
